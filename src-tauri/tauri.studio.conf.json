{
  "$schema": "https://raw.githubusercontent.com/nicoulaj/schemastore/master/src/schemas/json/tauri-v2.json",
  "productName": "韭菜盒子 Studio",
  "identifier": "com.jiucaihezi.studio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:studio",
    "beforeBuildCommand": "pnpm build:desktop:studio:quick"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "韭菜盒子 Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "transparent": false,
        "useHttpsScheme": true,
        "create": false
      }
    ]
  },
  "bundle": {
    "externalBin": [
      "binaries/opencode"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "jiucaihezi-studio"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://api.jiucaihezi.studio/updates/studio/latest.json"
      ]
    }
  }
}
