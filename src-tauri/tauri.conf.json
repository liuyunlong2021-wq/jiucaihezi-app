{
  "$schema": "https://raw.githubusercontent.com/nicoulaj/schemastore/master/src/schemas/json/tauri-v2.json",
  "productName": "韭菜盒子",
  "version": "2.2.23",
  "identifier": "com.jiucaihezi.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420/try/",
    "beforeDevCommand": "pnpm run build:deepseek-harness && pnpm dev",
    "beforeBuildCommand": "pnpm run build:deepseek-harness && pnpm build:desktop:quick"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "韭菜盒子",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "transparent": false,
        "useHttpsScheme": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://tauri.localhost https://tauri.localhost; connect-src 'self' asset: http://asset.localhost http://127.0.0.1:* http://localhost:* https://localhost:* ws://127.0.0.1:* ws://localhost:* http://tauri.localhost https://tauri.localhost https://*.jiucaihezi.studio https://api.github.com https://*.openai.com https://*.anthropic.com https://*.googleapis.com https://*.xai.dev https://*.myqcloud.com https://*.aiproxy.vip https://aiproxy.vip https://challenges.cloudflare.com; img-src 'self' data: blob: https: asset: http://asset.localhost http://tauri.localhost https://tauri.localhost; media-src 'self' data: blob: https: asset: http://asset.localhost http://tauri.localhost https://tauri.localhost; style-src 'self' 'unsafe-inline' http://tauri.localhost https://tauri.localhost; script-src 'self' http://tauri.localhost https://tauri.localhost; frame-src 'self'; font-src 'self' data: http://tauri.localhost https://tauri.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**",
            "$HOME/**",
            "$APPDATA/output/**",
            "$APPDATA/data/media/**",
            "$RESOURCE/storyboarder/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "resources": {
      "../public/skills": "skills",
      "../scripts/jiucaihezi-creation-mcp/dist": "creation-mcp",
      "resources/deepseek-harness": "deepseek-harness",
      "resources/storyboarder": "storyboarder"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: yunlong liu (RXD4L9387J)",
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "wix": null,
      "nsis": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "jiucaihezi"
        ]
      }
    },
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwM0RDMDAwRUZEN0I0MUMKUldRY3ROZnZBTUE5Z0pjTGxma0M0Z2NBbHBYaFova1k4ZEorUHQ1Z28wN05jUmo2L3NtVHFVNUcK",
      "endpoints": [
        "https://api.jiucaihezi.studio/updates/updater.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
