{
  "plugin": "yuanliu",
  "version": "0.2.0",
  "scope": "源流六个视频型号；公开名映射见 yuanliu-model-mapping.json",
  "coefficientConvention": "用户确认人民币售价；沿用现有 Task Usage 系数同数值口径，实际分组倍率与扣费待验收",
  "models": [
    {
      "model": "Seedance 2.5(HD)",
      "upstreamModel": "yl_seedance-2-5_6caffaca7390",
      "unit": "次",
      "salePriceCny": 6,
      "expression": "tier(\"base\", u(\"calls\") * 6)"
    },
    {
      "model": "Seedance 2.5 480p (QN-10)",
      "upstreamModel": "yl_pp_sz_sd25_30010",
      "unit": "次",
      "salePriceCny": 9,
      "expression": "tier(\"base\", u(\"calls\") * 9)"
    },
    {
      "model": "Seedance2.0(HD)",
      "upstreamModel": "yl_seedance-2-0_ba0687ff09f2",
      "unit": "次",
      "salePriceCny": 4,
      "expression": "tier(\"base\", u(\"calls\") * 4)"
    },
    {
      "model": "Seedance2.5full (LJ-04)",
      "upstreamModel": "yl_g7zy_seedance_v2_5_full_s",
      "unit": "秒",
      "salePriceCny": 0.5,
      "expression": "tier(\"base\", u(\"seconds\") * 0.5)"
    },
    {
      "model": "Wan3.0视频Prime官渠稳定(WP-01)",
      "upstreamModel": "yl_fy_wan3_0_video_prime",
      "unit": "秒",
      "salePriceCny": {
        "480p": 0.4,
        "720p": 0.5,
        "1080p": 0.7
      },
      "expression": "u(\"resolution\") == \"1080p\" ? tier(\"1080p\", u(\"seconds\") * 0.7) : u(\"resolution\") == \"720p\" ? tier(\"720p\", u(\"seconds\") * 0.5) : tier(\"480p\", u(\"seconds\") * 0.4)"
    },
    {
      "model": "Wan3.0官渠(WP-02)",
      "upstreamModel": "yl_fy_wan3_0_video",
      "unit": "秒",
      "salePriceCny": {
        "480p": 0.4,
        "720p": 0.5,
        "1080p": 0.6
      },
      "expression": "u(\"resolution\") == \"1080p\" ? tier(\"1080p\", u(\"seconds\") * 0.6) : u(\"resolution\") == \"720p\" ? tier(\"720p\", u(\"seconds\") * 0.5) : tier(\"480p\", u(\"seconds\") * 0.4)"
    }
  ]
}
