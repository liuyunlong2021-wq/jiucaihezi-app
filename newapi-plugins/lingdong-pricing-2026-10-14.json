{
  "plugin": "lingdong",
  "version": "0.4.1",
  "pricingRule": "用户指定售价：图片按张，视频按次；不按视频时长加价",
  "coefficientConvention": "沿用现有后台的人民币售价与Task Usage系数同数值口径；实扣待验证",
  "models": [
    {
      "model": "ld-2.5特价-1-720",
      "upstreamModel": "2.5特价-1-720",
      "salePriceCny": 4,
      "unit": "次",
      "expression": "tier(\"base\", u(\"calls\") * 4)"
    },
    {
      "model": "ld-gpt-image-2.5-flare",
      "upstreamModel": "gpt-image-2.5-flare",
      "salePriceCny": 0.08,
      "unit": "张",
      "expression": "tier(\"base\", u(\"image_count\") * 0.08)"
    }
  ]
}
