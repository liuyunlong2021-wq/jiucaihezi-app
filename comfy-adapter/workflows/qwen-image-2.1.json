{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen-image-2.1-UC-fp8.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load Diffusion Model (Qwen-Image 2.1 fp8)" }
  },
  "2": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": ["1", 0],
      "device": "auto",
      "dtype": "default"
    },
    "_meta": { "title": "Qwen Image 2.1 Cache（加速）" }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_bf16.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "_meta": { "title": "Load CLIP (Qwen3-VL 8B)" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    },
    "_meta": { "title": "Load VAE" }
  },
  "5": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "prompt": "",
      "negative_prompt": "",
      "resolution": 1024
    },
    "_meta": { "title": "Qwen 文本编码（prompt / negative / resolution 由适配层注入）" }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": { "title": "空 Latent（尺寸/张数由适配层注入）" }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "seed": 0,
      "steps": 40,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["5", 1],
      "latent_image": ["6", 0],
      "denoise": 1.0
    },
    "_meta": { "title": "采样（seed/steps 由适配层注入）" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["4", 0]
    },
    "_meta": { "title": "VAE Decode" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "adapter/qwen-image-2.1"
    },
    "_meta": { "title": "Save Image" }
  }
}
