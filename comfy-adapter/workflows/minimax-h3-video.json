    "_meta": { "title": "MiniMax H3 混合模型（同时支持 FL2VA 与 Ref2VA）" }
  },
  "2": {
    "class_type": "LoraLoaderBypassModelOnly",
    "inputs": {
      "model": ["1", 0],
